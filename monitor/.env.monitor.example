# docker-compose.yml reads these. Never commit the filled-in copy.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_VAULT=0x

# Slack incoming webhook for the team channel: every alert.
ALERT_WEBHOOK_URL=
# Second webhook that receives CRITICAL alerts only (Paused, reverted vault transactions,
# low float). Point it at PagerDuty/Opsgenie so on-call is woken.
PAGER_WEBHOOK_URL=

# Mainnet, after #1 and #14:
# BASE_RPC_URL=
# BASE_VAULT=0x
