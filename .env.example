# RPC endpoints (see foundry.toml [rpc_endpoints] and docs/networks.md). Fill only the chains you deploy to.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
MAINNET_RPC_URL=
# Etherscan API v2 key (one key for all chains above)
ETHERSCAN_API_KEY=

# DeploySettlementVault.s.sol inputs
# Native USDC for the chain you deploy to (see docs/networks.md). The vault refuses non-6-decimal tokens.
USDC_ADDRESS=
# Safe multisig
ADMIN_ADDRESS=
# Custody-provider MPC wallet used by the backend
OPERATOR_ADDRESS=
# Emergency pause key
PAUSER_ADDRESS=
# Independent reference-rate publisher (optional; admin can grant RATE_ORACLE_ROLE later)
RATE_ORACLE_ADDRESS=
# Seconds before a new admin can accept (default 2 days)
ADMIN_TRANSFER_DELAY=172800
# USDC base units (6 decimals): 50,000 USDC = 50000000000
MAX_PER_SETTLEMENT=50000000000
# 100,000 USDC
DAILY_LIMIT=100000000000

# NEVER put a private key here. Use: cast wallet import kimana-deployer --interactive

# monitor/ (see monitor/index.mjs)
RPC_URL=
VAULT_ADDRESS=
MIN_FLOAT_USDC=50000
ALERT_WEBHOOK_URL=
