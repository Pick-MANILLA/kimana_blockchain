# ── Dfns API credentials ──────────────────────────────────────────────────────
# Dfns application ID (from app.dfns.io → Settings → Applications)
DFNS_APP_ID=ap-xxxxxxxxxxxxxxxxxxxxxxxx

# Service-account credential key ID (not a blockchain key)
DFNS_CRED_ID=cr-xxxxxxxxxxxxxxxxxxxxxxxx

# Path to the PKCS#8 private key PEM for the service account.
# In production, load this from a secrets manager, not from disk.
DFNS_APP_PRIVATE_KEY_PATH=./dfns-service-account.pem

# Authentication token (short-lived; refresh via POST /auth/login)
DFNS_AUTH_TOKEN=eyJ...

# Dfns API base URL
DFNS_BASE_URL=https://api.dfns.io

# ── Operator wallet (OPERATOR_ROLE) ───────────────────────────────────────────
# Dfns wallet ID for the operator MPC wallet.
# The on-chain address of this wallet must hold OPERATOR_ROLE on VAULT_ADDRESS.
OPERATOR_WALLET_ID=wa-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Oracle wallet (RATE_ORACLE_ROLE) ──────────────────────────────────────────
# Dfns wallet ID for the rate oracle MPC wallet.
# The on-chain address must hold RATE_ORACLE_ROLE on VAULT_ADDRESS.
ORACLE_WALLET_ID=wa-yyyyyyyyyyyyyyyyyyyyyyyy

# ── Vault and network ─────────────────────────────────────────────────────────
# Deployed SettlementVault address on Base Sepolia (see deployments/84532.json)
VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Off-ramp partner address (must be allowlisted on the vault by the admin)
PARTNER_ADDRESS=0x0000000000000000000000000000000000000000

# Base Sepolia public RPC (used only for read-only calls; Dfns broadcasts txs)
RPC_URL=https://sepolia.base.org

# ── Policy approver (dfns-policy-approver.mjs) ────────────────────────────────
# Poll interval in milliseconds for checking pending signing requests
APPROVER_POLL_MS=2000

# NEVER put a blockchain private key here.
# Signing is done entirely inside Dfns's MPC network.
